---
import { Image } from 'astro:assets'
import { FeaturedProjectsListEn } from '../../data';

const host = (href?: string) => href ? new URL(href).hostname.replace(/^www\./, '') : ''
---

<section id="proyectos" class="projects" aria-labelledby="projects-title">
    <div class="projects-inner">
        <header class="projects-head">
            <h2 id="projects-title" class="projects-title">Featured projects</h2>
            <p>Three products of my own that I designed, built and shipped. They are live, so you can visit them.</p>
        </header>

        <ul class="case-list">
            {FeaturedProjectsListEn.map((project, i) => (
                <li class={`case ${i % 2 === 1 ? 'case-reverse' : ''}`}>
                    <div class="browser">
                        <div class="browser-bar">
                            <span class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                            {project.DemoLink?.Href
                                ? <a class="browser-url" href={project.DemoLink.Href} target="_blank" rel="noopener noreferrer" title={project.DemoLink.Title}>{host(project.DemoLink.Href)}</a>
                                : <span class="browser-url">{project.Name}</span>}
                        </div>
                        <a href={project.DetailsLink.Href} class="browser-shot" tabindex="-1" aria-hidden="true">
                            <Image
                                src={project.CoverImage.Image}
                                format="webp"
                                widths={[480, 760, 1100]}
                                sizes="(max-width: 980px) 92vw, 640px"
                                alt={project.CoverImage.Alt}
                                loading="lazy"
                            />
                        </a>
                    </div>
                    <div class="case-body">
                        <h3 class="case-title"><a href={project.DetailsLink.Href} title={project.DetailsLink.Title}>{project.Name}</a></h3>
                        <p class="case-tagline">{project.Tagline}</p>
                        {project.Highlights && (
                            <ul class="case-highlights">
                                {project.Highlights.map(h => <li>{h}</li>)}
                            </ul>
                        )}
                        <ul class="case-stack" aria-label="Technologies">
                            {project.Languages.map(lang => (
                                <li><Image src={lang.Logo.Image} alt="" height={40} format="webp" loading="lazy" />{lang.Name}</li>
                            ))}
                        </ul>
                        <div class="action-row">
                            <a href={project.DetailsLink.Href} class="light-button button">View project</a>
                            {project.DemoLink?.Href && (
                                <a href={project.DemoLink.Href} target="_blank" rel="noopener noreferrer" class="text-link">Visit {host(project.DemoLink.Href)}</a>
                            )}
                        </div>
                    </div>
                </li>
            ))}
        </ul>

        <a href="/en/projects" class="see-more outline-light-button button">See all projects</a>
    </div>
</section>
<div class="wave-container" aria-hidden="true"></div>
