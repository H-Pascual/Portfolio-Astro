---
import { Image } from 'astro:assets'
import HectorSuitPicture from '../../assets/content/hector-suit-picture.webp'
import CvPdf from '../../assets/content/English CV_Hector_Pascual_FullStack.pdf'
import { ProjectListEn } from '../../data/ProjectListEn'

// Figures computed from the data so they stay up to date
const corporate = ProjectListEn.filter(p => p.Category === 'professional').length
const total = ProjectListEn.length
const firstJob = new Date('2024-03-01')
const years = Math.floor(((Date.now() - firstJob.getTime()) / (365.25 * 24 * 3600 * 1000)) * 2) / 2
const yearsLabel = `${years}+`
---
<section id="inicio" class="hero" aria-labelledby="hero-title">
    <div class="hero-content">
        <p class="hero-status"><span class="status-dot" aria-hidden="true"></span>Open to new roles: FullStack, AI or Tech Lead · remote or in Alicante</p>
        <h2 id="hero-title" class="hero-title">
            <span class="hero-kicker">FullStack Developer in Alicante, Spain</span>
            I design, build and lead the software a company runs on every day.
        </h2>
        <p class="hero-description">I'm Héctor Pascual. I take projects from start to finish: architecture, <strong>C# and .NET</strong> backend, <strong>React and TypeScript</strong> frontend and team coordination. I sit on my company's artificial intelligence committee, run internal AI training and, in my spare time, ship products of my own.</p>
        <div class="action-row">
            <a href="#contacto" class="primary-button button">Get in touch</a>
            <a href={CvPdf} class="secondary-button button" download="CV-Hector-Pascual-Marin-EN.pdf">Download CV</a>
        </div>
        <dl class="hero-stats">
            <div><dt>years of professional experience</dt><dd>{yearsLabel}</dd></div>
            <div><dt>corporate applications designed</dt><dd>{corporate}</dd></div>
            <div><dt>developers on my team</dt><dd>2</dd></div>
            <div><dt>projects in this portfolio</dt><dd>{total}</dd></div>
        </dl>
    </div>
    <figure class="hero-portrait">
        <Image src={HectorSuitPicture}
            class="hero-image"
            format="webp"
            loading="eager"
            fetchpriority="high"
            widths={[360, 560, 720]}
            sizes="(max-width: 988px) 70vw, 440px"
            alt="Héctor Pascual Marín, FullStack Developer in Alicante" />
        <figcaption>Alicante, Spain</figcaption>
    </figure>
</section>
