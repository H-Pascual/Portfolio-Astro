---
import EurobananLogo from '../../assets/companies/eurobanan-logo.png'
import InetumLogo from '../../assets/companies/inetum-logo.png'
import SanVicenteLogo from '../../assets/companies/ies-san-vicente-logo.png'
import MariaBlascoLogo from '../../assets/companies/ies-maria-blasco-logo.jpg'
import OpenWebinarsLogo from '../../assets/companies/openwebinars-logo.png'
import CambridgeLogo from '../../assets/companies/cambridge-logo.png'
import { Image } from 'astro:assets'

const experience = [
  {
    role: 'FullStack Developer', org: 'Eurobanan', dates: 'July 2024 – present', logo: EurobananLogo, alt: 'Eurobanan logo',
    points: [
      'Lead development teams: planning, technical oversight and coordination across roles.',
      'Member of the Artificial Intelligence Committee, defining the company\'s AI strategy and use cases.',
      'Run internal artificial intelligence training for teams across different departments.',
      'Designed and built an AI chatbot for website support.',
      'Build and maintain internal applications designed to scale, perform well and stay easy to maintain.',
      'Frontend in React, TypeScript, Vite and DevExpress; backend in C# and .NET Core with RESTful APIs and business logic.',
      'Contribute to defining and evolving the software architecture, based on Clean Architecture.',
      'Unit tests, technical documentation, pull request reviews and user story management.',
    ],
  },
  {
    role: 'Backend Developer', org: 'Inetum', dates: 'March 2024 – June 2024', logo: InetumLogo, alt: 'Inetum logo',
    points: [
      'Built and managed C# and .NET Core microservices for the healthcare sector.',
      'Automated workflows with Azure Logic Apps.',
    ],
  },
]

const studies = [
  { title: 'Specialisation in Artificial Intelligence and Big Data', org: 'IES San Vicente', dates: 'September 2024 – June 2025', logo: SanVicenteLogo, alt: 'IES San Vicente logo' },
  { title: 'Higher Technician Diploma in Web Application Development', org: 'IES San Vicente', dates: 'September 2022 – June 2024', logo: SanVicenteLogo, alt: 'IES San Vicente logo' },
  { title: 'Science and Technology Baccalaureate', org: 'IES María Blasco', dates: 'September 2020 – June 2022', logo: MariaBlascoLogo, alt: 'IES María Blasco logo' },
]

const certifications = [
  { title: '.NET Framework course (10 h)', org: 'OpenWebinars', dates: 'March 2024', logo: OpenWebinarsLogo, alt: 'OpenWebinars logo' },
  { title: 'TypeScript course (14 h)', org: 'OpenWebinars', dates: 'March 2024', logo: OpenWebinarsLogo, alt: 'OpenWebinars logo' },
  { title: 'Intermediate C# course (8 h)', org: 'OpenWebinars', dates: 'March 2024', logo: OpenWebinarsLogo, alt: 'OpenWebinars logo' },
  { title: 'English B2 First (score 168)', org: 'Cambridge University', dates: 'August 2021', logo: CambridgeLogo, alt: 'Cambridge University logo' },
]

const skills = [
  { area: 'Frontend', items: 'React, TypeScript, JavaScript, Astro, Angular, HTML, CSS, SASS, Bootstrap' },
  { area: 'Backend', items: 'C#, .NET Core, Node.js, PHP, Python, REST APIs' },
  { area: 'Databases', items: 'SQL, Oracle, MariaDB, NoSQL (MongoDB)' },
  { area: 'Tools', items: 'Git, Docker, Azure Logic Apps' },
  { area: 'Ways of working', items: 'Agile methodologies, team leadership, internal AI training' },
]
---
<section id="resumen" class="summary" aria-labelledby="summary-heading">
  <header class="summary-head">
    <h2 id="summary-heading">Experience and education</h2>
    <p>Over two years building production business software, leading development teams and driving the adoption of artificial intelligence.</p>
  </header>

  <div class="summary-block summary-exp">
    <h3 class="summary-title">Work experience</h3>
    <ol class="timeline">
      {experience.map(job => (
        <li class="summary-item">
          <span class="summary-marker" aria-hidden="true"></span>
          <div class="summary-header">
            <div class="summary-text">
              <h4 class="summary-job-title">{job.role} <span class="summary-org">at {job.org}</span></h4>
              <span class="summary-subtitle">{job.dates}</span>
            </div>
            <Image src={job.logo} format="webp" width={112} class="summary-image" alt={job.alt} loading="lazy" />
          </div>
          <ul class="summary-points">
            {job.points.map(p => <li>{p}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>

  <div class="summary-block summary-studies">
    <h3 class="summary-title">Education</h3>
    <ol class="timeline">
      {studies.map(s => (
        <li class="summary-item">
          <span class="summary-marker" aria-hidden="true"></span>
          <div class="summary-header">
            <div class="summary-text">
              <h4 class="summary-job-title">{s.title}</h4>
              <span class="summary-subtitle">{s.org}, {s.dates}</span>
            </div>
            <Image src={s.logo} format="webp" width={112} class="summary-image" alt={s.alt} loading="lazy" />
          </div>
        </li>
      ))}
    </ol>
  </div>

  <aside class="summary-aside" aria-label="Achievements, skills and languages">
    <div class="summary-award">
      <h3 class="summary-title">Highlighted achievement</h3>
      <p class="award-rank">3rd prize, FemFutur</p>
      <p class="summary-subtitle">Caixa Popular, May 2024</p>
      <p class="summary-description">A web platform for finding home cleaning staff. Third place out of more than 200 participants.</p>
    </div>

    <div>
      <h3 class="summary-title">Skills</h3>
      <dl class="skills">
        {skills.map(s => (<div><dt>{s.area}</dt><dd>{s.items}</dd></div>))}
      </dl>
    </div>

    <div>
      <h3 class="summary-title">Languages</h3>
      <dl class="skills skills-inline">
        <div><dt>Spanish</dt><dd>Native</dd></div>
        <div><dt>Valencian</dt><dd>B2</dd></div>
        <div><dt>English</dt><dd>B2</dd></div>
      </dl>
    </div>

    <div>
      <h3 class="summary-title">Certifications</h3>
      <ul class="cert-list">
        {certifications.map(c => (
          <li>
            <Image src={c.logo} format="webp" width={64} class="cert-logo" alt={c.alt} loading="lazy" />
            <div><span class="cert-title">{c.title}</span><span class="summary-subtitle">{c.org}, {c.dates}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </aside>

  <div class="summary-block summary-contact">
    <h3 class="summary-title">Direct contact</h3>
    <p class="summary-contact-lines">
      <a href="mailto:hector.pascual.marin@gmail.com">hector.pascual.marin@gmail.com</a>
      <a href="tel:+34653039281">+34 653 039 281</a>
    </p>
    <div class="action-row">
      <a href="https://www.linkedin.com/in/h%C3%A9ctor-pascual-mar%C3%ADn-953787232/" target="_blank" rel="noopener noreferrer" class="linkedin button">LinkedIn</a>
      <a href="https://github.com/H-Pascual" target="_blank" rel="noopener noreferrer" class="github button">GitHub</a>
      <a href="/en/curriculum/" class="secondary-button button">See resume</a>
    </div>
  </div>
</section>
