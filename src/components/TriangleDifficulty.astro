---
// difficulty: 1 (básico) a 3 (avanzado)
const { difficulty = 0 } = Astro.props;
const level = Math.max(0, Math.min(3, difficulty));
const bars = [
  { x: 0, h: 40 },
  { x: 36, h: 70 },
  { x: 72, h: 100 },
];
---
<svg class="difficulty" viewBox="0 0 100 100" width="18" height="18" aria-hidden="true" focusable="false">
  {bars.map((b, i) => (
    <rect x={b.x} y={100 - b.h} width="28" height={b.h} rx="4"
      fill={level > i ? 'var(--accent)' : 'currentColor'}
      fill-opacity={level > i ? 1 : 0.22} />
  ))}
</svg>
