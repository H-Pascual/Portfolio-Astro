---
import { Image } from 'astro:assets';
import { FeaturedLanguages } from '../data';
const unique = FeaturedLanguages.filter((lang, i, arr) => arr.findIndex(l => l.Name === lang.Name) === i);
---

<section id="languages-carousel" class="stack-band" aria-label="Tecnologías con las que trabajo">
  <div class="stack-track">
    {[0, 1].map(copy => (
      <ul class="stack-list" aria-hidden={copy === 1 ? 'true' : undefined}>
        {unique.map(lang => (
          <li>
            <a href={lang.Link.Href} title={lang.Link.Title} tabindex={copy === 1 ? -1 : undefined}
              target={lang.Link.Target ? '_blank' : '_self'} rel={lang.Link.Target ? 'noopener noreferrer' : undefined}>
              <Image loading="lazy" src={lang.Logo.Image} alt="" height={64} format="webp" />
              <span>{lang.Name}</span>
            </a>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>
