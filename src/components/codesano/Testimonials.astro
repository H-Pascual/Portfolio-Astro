---
const reviews = [
  { name: 'Celeste', stars: 5, text: 'Pude lanzar mi comercio online tranquila gracias a cómo me explicó los cambios que hizo y cómo dejarlo listo para mantenerlo yo sola después.' },
  { name: 'Enrique Espín', stars: 4, text: 'Me arregló los bugs que me impedían lanzar mi proyecto y, de paso, me ayudó muchísimo limpiando el código y revisando la seguridad de toda la web.' },
  { name: 'Fernando Marín', stars: 5, text: 'Héctor me ayudó a preparar mi web educativa para mis clases como profesor. Mejoró muchísimo el diseño y la eficiencia general de la web.' },
];
---
<section class="cs-section-tight" id="valoraciones">
  <div class="cs-wrap">
    <div class="cs-eyebrow cs-reveal">Lo que dicen quienes ya han trabajado conmigo</div>
    <div class="cs-reviews">
      {reviews.map((r) => (
        <div class="cs-review cs-reveal">
          <div class="cs-review-stars">
            {Array.from({ length: 5 }).map((_, i) => (
              <span class={i < r.stars ? 'cs-star cs-star-on' : 'cs-star'}>★</span>
            ))}
          </div>
          <p class="cs-review-text">"{r.text}"</p>
          <div class="cs-review-author">
            <div class="cs-review-avatar">{r.name.charAt(0)}</div>
            <div class="cs-review-name">{r.name}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cs-reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px;}
  @media (max-width:820px){.cs-reviews{grid-template-columns:1fr;}}
  .cs-review{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:26px;display:flex;flex-direction:column;gap:14px;transition:transform .2s ease, box-shadow .2s ease;}
  .cs-review:hover{transform:translateY(-3px);box-shadow:0 18px 30px -22px rgba(18,21,28,.35);}
  .cs-review-stars{display:flex;gap:2px;font-size:15px;color:var(--line);}
  .cs-star-on{color:#E8B94B;}
  .cs-review-text{font-size:14.5px;color:var(--ink-soft);flex-grow:1;}
  .cs-review-author{display:flex;align-items:center;gap:10px;}
  .cs-review-avatar{
    width:32px;height:32px;border-radius:50%;background:var(--accent-soft);color:var(--accent-dark);
    display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:700;font-size:13px;flex-shrink:0;
  }
  .cs-review-name{font-size:13.5px;font-weight:600;}
</style>