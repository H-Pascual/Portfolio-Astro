---
import HectorSuitPicture from '../../assets/content/hector_blue_suit.png'
import { Image } from 'astro:assets'
const badges = [
  'FullStack Developer en producción (React/TS + C#/.NET)',
  'Especialización en Inteligencia Artificial y Big Data',
  'Clean Architecture, DDD y CQRS aplicados a diario',
  '3er premio FemFutur — Caixa Popular',
];
const experience = [
  { company: 'Eurobanan', role: 'FullStack Developer', period: 'Actual', desc: 'Desarrollo y mantenimiento de sistemas de gestión reales con React, TypeScript y C#/.NET, aplicando Clean Architecture para que el código aguante el paso del tiempo.' },
  { company: 'Inetum', role: 'Desarrollador de microservicios', period: 'Anterior', desc: 'Microservicios para el ámbito sanitario, trabajando con sistemas críticos donde la fiabilidad y la seguridad no son opcionales.' },
];
const stats = [
  { n: '2+', l: 'años en desarrollo profesional' },
  { n: '2', l: 'empresas de software real' },
  { n: '100%', l: 'de los proyectos con seguridad revisada' },
];
---
<section class="cs-section cs-section-alt" id="sobre-mi">
  <div class="cs-wrap">
    <div class="cs-eyebrow cs-reveal">Quién hay detrás</div>
    <h2 class="cs-reveal">Héctor Pascual — FullStack Developer</h2>
    <p class="cs-about-lead cs-reveal">No es un curso online ni un "he trasteado con código". Es mi trabajo del día a día en empresas reales, aplicado a arreglar lo que la IA no supo dejar bien hecho.</p>

    <div class="cs-about-grid">
      <div class="cs-reveal">
        <div class="cs-avatar-card">
          <Image
            class="cs-avatar-photo"
            src={HectorSuitPicture}
            alt="Héctor Pascual Marín, FullStack Developer"
            loading="lazy"
            width="240"
            height="340"
          />
          <div class="cs-avatar-name">Héctor Pascual Marín</div>
          <div class="cs-avatar-role">FullStack Developer</div>
        </div>
        <div class="cs-badges">
          {badges.map((b) => <div class="cs-badge">{b}</div>)}
        </div>
      </div>

      <div class="cs-reveal">
        <div class="cs-stats-row">
          {stats.map((s) => (
            <div class="cs-about-stat">
              <div class="cs-about-stat-n">{s.n}</div>
              <div class="cs-about-stat-l">{s.l}</div>
            </div>
          ))}
        </div>

        <div class="cs-exp-list">
          {experience.map((e) => (
            <div class="cs-exp-item">
              <div class="cs-exp-top">
                <div>
                  <div class="cs-exp-company">{e.company}</div>
                  <div class="cs-exp-role">{e.role}</div>
                </div>
                <div class="cs-exp-period">{e.period}</div>
              </div>
              <p class="cs-exp-desc">{e.desc}</p>
            </div>
          ))}
        </div>

        <p class="cs-about-closing">Mi trabajo diario es justo esto: coger sistemas complejos y mantenerlos sólidos, seguros y fáciles de evolucionar. Aplico exactamente el mismo criterio cuando arreglo una app construida con IA — la diferencia es que aquí no partimos de cero, partimos de lo que ya tienes y lo dejamos bien hecho.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cs-about-lead{color:var(--text-muted);font-size:16.5px;max-width:620px;margin-top:14px;}
  .cs-about-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:48px;align-items:start;margin-top:44px;}
  @media (max-width:820px){.cs-about-grid{grid-template-columns:1fr;}}

  .cs-avatar-card{
    background:var(--ink);color:var(--on-ink);border-radius:var(--radius);
    padding:24px 22px 28px;text-align:center;margin-bottom:20px;
  }
  .cs-avatar-photo{
    width:140px;height:175px;
    object-fit:cover;
    border-radius:14px;
    margin:0 auto 16px;
    display:block;
    box-shadow:0 12px 24px -10px rgba(0,0,0,.45);
    border:1px solid var(--ink-line);
  }
  .cs-avatar-name{font-family:var(--font-display);font-size:17px;font-weight:600;}
  .cs-avatar-role{font-family:var(--font-mono);font-size:12px;color:var(--text-muted-on-ink);margin-top:4px;}

  .cs-badges{display:flex;flex-direction:column;gap:12px;}
  .cs-badge{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 16px;font-size:13.5px;font-weight:500;display:flex;gap:10px;align-items:center;}
  .cs-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--success);flex-shrink:0;}

  .cs-stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:28px;}
  @media (max-width:520px){.cs-stats-row{grid-template-columns:1fr;}}
  .cs-about-stat{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px;text-align:center;}
  .cs-about-stat-n{font-family:var(--font-display);font-size:28px;font-weight:600;color:var(--accent-dark);}
  .cs-about-stat-l{font-size:12.5px;color:var(--text-muted);margin-top:4px;}

  .cs-exp-list{display:flex;flex-direction:column;gap:14px;margin-bottom:22px;}
  .cs-exp-item{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px 22px;}
  .cs-exp-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;}
  .cs-exp-company{font-family:var(--font-display);font-size:18px;font-weight:600;}
  .cs-exp-role{font-size:13.5px;color:var(--text-muted);margin-top:2px;}
  .cs-exp-period{font-family:var(--font-mono);font-size:11.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--accent);background:var(--accent-soft);padding:4px 10px;border-radius:999px;flex-shrink:0;}
  .cs-exp-desc{font-size:14.5px;color:var(--text-muted);margin-top:12px;}

  .cs-about-closing{color:var(--text-muted);font-size:16px;}
</style>