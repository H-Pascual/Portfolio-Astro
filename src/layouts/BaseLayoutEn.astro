---
import '../styles/global.css'
import '../styles/index.css'
import HeaderEn from '../components/en/HeaderEn.astro'
import 'flag-icon-css/css/flag-icons.min.css'
import SpeedInsights from "@vercel/speed-insights/astro"
import Analytics from '@vercel/analytics/astro'

interface Props {
	title?: string
	description?: string
	image?: string
	type?: 'website' | 'article'
	noindex?: boolean
	/** Nodos JSON-LD extra para esta página (proyecto, migas de pan…) */
	schema?: Record<string, unknown>[]
}

const SITE = 'https://www.hectorpascual.com'
const DEFAULT_TITLE = 'Héctor Pascual Marín - FullStack Developer | Alicante Programmer'
const DEFAULT_DESCRIPTION = 'Héctor Pascual Marín, FullStack Developer in Alicante, Spain. I design and lead web apps with C#/.NET, React, TypeScript and AI. Open to new roles.'

const {
	title = DEFAULT_TITLE,
	description = DEFAULT_DESCRIPTION,
	image = `${SITE}/images/og-hector-pascual-marin.jpg`,
	type = 'website',
	noindex = false,
	schema = [],
} = Astro.props

// Canonical URL per page
const path = Astro.url.pathname
const canonical = new URL(path, SITE).href
const esPath = path.replace(/^\/en(\/|$)/, '/')
const enPath = esPath === '/' ? '/en/' : `/en${esPath}`
const year = new Date().getFullYear()
const isHome = (path === "/en/" || path === "/en")

const personSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": `${SITE}/#person`,
			"name": "Héctor Pascual Marín",
			"alternateName": ["Héctor Pascual", "Hector Pascual Marin"],
			"givenName": "Héctor",
			"familyName": "Pascual Marín",
			"url": `${SITE}/`,
			"mainEntityOfPage": `${SITE}/`,
			"image": `${SITE}/images/hector-suit-picture.webp`,
			"jobTitle": "FullStack Developer",
			"hasOccupation": {
				"@type": "Occupation",
				"name": "FullStack Developer",
				"occupationLocation": { "@type": "City", "name": "Alicante" },
				"skills": "C#, .NET, React, TypeScript, SQL, Clean Architecture, Artificial Intelligence, technical leadership"
			},
			"description": DEFAULT_DESCRIPTION,
			"email": "mailto:hector.pascual.marin@gmail.com",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Alicante",
				"addressRegion": "Comunidad Valenciana",
				"addressCountry": "ES"
			},
			"homeLocation": { "@type": "Place", "name": "Alicante, Spain" },
			"worksFor": { "@type": "Organization", "name": "Eurobanan" },
			"alumniOf": { "@type": "EducationalOrganization", "name": "IES San Vicente" },
			"knowsAbout": ["FullStack development", "Web development", "React", "TypeScript", "C#", ".NET", "Astro", "Clean Architecture", "Artificial Intelligence"],
			"knowsLanguage": ["es", "ca", "en"],
			"sameAs": [
				"https://www.linkedin.com/in/h%C3%A9ctor-pascual-mar%C3%ADn-953787232/",
				"https://github.com/H-Pascual"
			]
		},
		{
			"@type": "WebSite",
			"@id": `${SITE}/#website`,
			"url": `${SITE}/`,
			"name": "Héctor Pascual Marín",
			"alternateName": "Héctor Pascual - FullStack Developer in Alicante",
			"inLanguage": "en-GB",
			"publisher": { "@id": `${SITE}/#person` }
		},
		...(isHome ? [{
			"@type": "ProfilePage",
			"@id": `${canonical}#profile`,
			"url": canonical,
			"name": title,
			"inLanguage": "en-GB",
			"dateModified": new Date().toISOString(),
			"mainEntity": { "@id": `${SITE}/#person` },
			"isPartOf": { "@id": `${SITE}/#website` }
		}] : []),
		...schema
	]
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Héctor Pascual, Héctor Pascual Marín, FullStack Developer Alicante, web developer Alicante, developer in Alicante Spain, hire a web developer, freelance developer Spain, React, TypeScript, C#, .NET" />
		<meta name="author" content="Héctor Pascual Marín" />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
		<meta name="geo.region" content="ES-A" />
		<meta name="geo.placename" content="Alicante" />
		<meta name="theme-color" content="#14202C" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/favicon-180.png" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&display=swap" rel="stylesheet" />

		<link rel="canonical" href={canonical} />
		<link rel="me" href="https://www.linkedin.com/in/h%C3%A9ctor-pascual-mar%C3%ADn-953787232/" />
		<link rel="me" href="https://github.com/H-Pascual" />
		<link rel="alternate" hreflang="es" href={new URL(esPath, SITE).href} />
		<link rel="alternate" hreflang="en" href={new URL(enPath, SITE).href} />
		<link rel="alternate" hreflang="x-default" href={new URL(esPath, SITE).href} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:alt" content="Héctor Pascual Marín, FullStack Developer in Alicante" />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Héctor Pascual Marín" />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:locale:alternate" content="es_ES" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Skip to content</a>
		<HeaderEn home={isHome}></HeaderEn>
		<main id="contenido">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="site-footer-inner">
				<p class="site-footer-name">Héctor Pascual Marín <span>FullStack Developer in Alicante, Spain</span></p>
				<nav aria-label="Footer links">
					<a href="mailto:hector.pascual.marin@gmail.com">hector.pascual.marin@gmail.com</a>
					<a href="https://www.linkedin.com/in/h%C3%A9ctor-pascual-mar%C3%ADn-953787232/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					<a href="https://github.com/H-Pascual" target="_blank" rel="noopener noreferrer">GitHub</a>
				</nav>
				<p class="site-footer-legal">© {year} Héctor Pascual Marín</p>
			</div>
		</footer>
		<Analytics />
		<SpeedInsights />
	</body>
</html>
