---
import BaseLayoutEn from '../layouts/BaseLayoutEn.astro'
import { ProjectListEn } from "../data/ProjectListEn";
import { Image, getImage } from 'astro:assets'
import TriangleDifficulty from '../components/TriangleDifficulty.astro';
import ProjectCard from '../components/ProjectCard.astro';
const { project } = Astro.props;

const levels = ['Basic', 'Intermediate', 'Advanced']
const host = (href?: string) => href ? new URL(href).hostname.replace(/^www\./, '') : ''
const year = project.EndDate.getFullYear()
const metaDescription = `${project.Name}: ${project.Tagline ?? ''} A project by Héctor Pascual Marín, FullStack Developer in Alicante.`.replace(/\s+/g, ' ')
const og = await getImage({ src: project.CoverImage.Image, width: 1200, format: 'jpg' })
const ogImage = new URL(og.src, 'https://www.hectorpascual.com').href
const others = ProjectListEn.filter(proj => proj.ID != project.ID).slice(0, 3)
---

<BaseLayoutEn title={`${project.Name} - Project by Héctor Pascual Marín`} description={metaDescription} image={ogImage} type="article">
    <article class="project-details" id="detalles" aria-labelledby="project-title">
        <a href="/en/projects" class="back-link">All projects</a>
        <header class="details-head">
            <div class="details-heading">
                <h2 id="project-title">{project.Name}</h2>
                {project.Tagline && <p class="details-tagline">{project.Tagline}</p>}
            </div>
            <dl class="details-meta">
                <div><dt>Year</dt><dd>{year}</dd></div>
                <div><dt>Complexity</dt><dd class="details-level"><TriangleDifficulty difficulty={project.Difficulty + 1}></TriangleDifficulty>{levels[project.Difficulty]}</dd></div>
                <div><dt>Stack</dt><dd class="details-stack">
                    {project.Languages.map(lang => (
                        <span><Image format="webp" src={lang.Logo.Image} alt="" height={40} />{lang.Name}</span>
                    ))}
                </dd></div>
            </dl>
            <div class="details-action-buttons action-row">
                {project.HasDemo && project.DemoLink?.Href && <a target="_blank" rel="noopener noreferrer" title={project.DemoLink.Title} href={project.DemoLink.Href} class="primary-button button">Visit {host(project.DemoLink.Href)}</a>}
                {project.GithubLink?.Href && <a target="_blank" rel="noopener noreferrer" title={project.GithubLink.Title} href={project.GithubLink.Href} class="github button">View code on GitHub</a>}
            </div>
        </header>

        {project.Video && (
            <figure class="details-video">
                <video controls preload="none" playsinline poster={project.Video.Poster} title={project.Video.Title}>
                    <source src={project.Video.Src} type="video/mp4" />
                    {project.Video.SrcWebm && <source src={project.Video.SrcWebm} type="video/webm" />}
                </video>
                <figcaption>{project.Video.Title}</figcaption>
            </figure>
        )}

        <div class="details-carousel">
            <div class="details-carousel-wrapper">
                <button class="details-carousel-button prev" type="button" aria-label="Previous image" onclick="scrollCarousel(-1)">&#10094;</button>
                <div class="details-carousel-track-container">
                    <div class="details-carousel-track">
                        {project.Images.map((img, i) => (
                            <Image
                                format="webp"
                                src={img.Image}
                                widths={[480, 760, 1100]}
                                sizes="(max-width: 600px) 88vw, (max-width: 900px) 48vw, 32vw"
                                alt={img.Alt}
                                class="details-carousel-image"
                                loading={i < 3 ? 'eager' : 'lazy'}
                            />
                        ))}
                    </div>
                </div>
                <button class="details-carousel-button next" type="button" aria-label="Next image" onclick="scrollCarousel(1)">&#10095;</button>
            </div>
        </div>

        <div class="details-body">
            <div class="details-description">
                <h3>About the project</h3>
                <p>{project.Description}</p>
            </div>
            {project.Highlights && (
                <div class="details-highlights">
                    <h3>Highlights</h3>
                    <ul>{project.Highlights.map((h: string) => <li>{h}</li>)}</ul>
                </div>
            )}
        </div>

        <aside class="details-cta">
            <p>Need something similar for your company?</p>
            <a href="/en/#contacto" class="primary-button button">Let's talk</a>
        </aside>
    </article>

    <section class="recommended-projects" id="recomendados" aria-labelledby="rec-title">
        <h3 id="rec-title">More projects</h3>
        <div class="projects-container">
            {others.map(p => <ProjectCard project={p} lang="en" />)}
        </div>
    </section>
</BaseLayoutEn>

<script is:inline>
  function scrollCarousel(direction) {
    const container = document.querySelector(".details-carousel-track-container");
    const image = container && container.querySelector(".details-carousel-image");
    if (!image) return;
    const gap = parseInt(getComputedStyle(image.parentElement).columnGap || '0', 10) || 0;
    container.scrollBy({ left: direction * (image.offsetWidth + gap), behavior: 'smooth' });
  }
  window.scrollCarousel = scrollCarousel;
</script>
