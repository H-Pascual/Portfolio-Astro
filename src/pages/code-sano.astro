---
import PageLoader from '../components/codesano/PageLoader.astro';
import Nav from '../components/codesano/Nav.astro';
import Hero from '../components/codesano/Hero.astro';
import Problem from '../components/codesano/Problem.astro';
import Pricing from '../components/codesano/Pricing.astro';
import Calculator from '../components/codesano/Calculator.astro';
import Process from '../components/codesano/Process.astro';
import CaseStudy from '../components/codesano/CaseStudy.astro';
import About from '../components/codesano/About.astro';
import FAQ from '../components/codesano/FAQ.astro';
import FinalCTA from '../components/codesano/FinalCTA.astro';
import Footer from '../components/codesano/Footer.astro';
import WhatsAppFloat from '../components/codesano/WhatsAppFloat.astro';
import Testimonials from '../components/codesano/Testimonials.astro';

const title = "CodeSano — Arreglo y aseguro apps y webs creadas con IA";
const description = "¿Tu web o app la creaste con IA (Lovable, Bolt, Replit, Cursor...) y ahora falla o no sabes si es segura? Arreglo bugs, refuerzo la seguridad y dejo tu código listo para crecer. Diagnóstico gratis por WhatsApp.";
---
<html lang="es">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18059505411"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'AW-18059505411');
  </script>

  <!-- Conversión: clic en cualquier enlace de WhatsApp -->
  <script is:inline>
    function gtag_report_conversion(url) {
      var callback = function () {
        if (typeof(url) != 'undefined') {
          window.location = url;
        }
      };
      gtag('event', 'conversion', {
          'send_to': 'AW-18059505411/2hp0CI3mn5YcEIPeuKND',
          'value': 1.0,
          'currency': 'EUR',
          'event_callback': callback
      });
      return false;
    }
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" type="image/svg+xml" href="/favicon_code.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon-180.png" />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="codesano-page">
  <PageLoader />
  <Nav />
  <Hero />
  <Problem />
  <Pricing />
  <Calculator />
  <Process />
  <CaseStudy />
  <Testimonials />
  <About />
  <FAQ />
  <FinalCTA />
  <Footer />
  <WhatsAppFloat />
</body>
</html>

<style is:global>
  .codesano-page{
    --ink:#12151C;
    --ink-soft:#1C2130;
    --ink-line:#333A4D;
    --paper:#EFF1EC;
    --paper-2:#E3E6DD;
    --line:#CDD1C4;
    --text-muted:#5C6055;
    --text-muted-on-ink:#A7ADBE;
    --on-ink:#F4F3EC;
    --accent:#3559E0;
    --accent-dark:#243F9E;
    --accent-soft:#E7EBFB;
    --success:#1B8E4C;
    --success-soft:#E4F3EA;
    --danger:#D6472F;
    --radius:16px;
    --font-display:'Fraunces', serif;
    --font-body:'Inter', sans-serif;
    --font-mono:'JetBrains Mono', monospace;
    --maxw:1120px;

    margin:0;
    font-family:var(--font-body);
    background:var(--paper);
    color:var(--ink);
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  .codesano-page *{box-sizing:border-box;}
  .codesano-page img{max-width:100%;display:block;}
  .codesano-page a{color:inherit;}

  .codesano-page .cs-wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px;}
  .codesano-page .cs-eyebrow{
    font-family:var(--font-mono);
    font-size:12.5px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--accent);
    font-weight:600;
    display:flex;
    align-items:center;
    gap:8px;
    margin-bottom:14px;
  }
  .codesano-page .cs-eyebrow::before{content:'';width:18px;height:1px;background:var(--accent);display:inline-block;}
  .codesano-page h1,
  .codesano-page h2,
  .codesano-page h3{font-family:var(--font-display);font-weight:600;margin:0;letter-spacing:-0.01em;}
  .codesano-page h1{font-size:clamp(34px,5vw,56px);line-height:1.06;font-weight:600;}
  .codesano-page h2{font-size:clamp(26px,3.4vw,38px);line-height:1.12;}
  .codesano-page h3{font-size:20px;line-height:1.3;}
  .codesano-page p{margin:0;}

  .codesano-page .cs-section{padding:88px 0;}
  .codesano-page .cs-section-alt{background:var(--paper-2);}
  .codesano-page .cs-section-tight{padding:56px 0;}
  @media (max-width:640px){
    .codesano-page .cs-section{padding:56px 0;}
  }

  .codesano-page .cs-btn{
    display:inline-flex;align-items:center;gap:8px;
    font-family:var(--font-body);font-weight:600;font-size:15px;
    padding:13px 22px;border-radius:999px;text-decoration:none;
    border:1px solid transparent;cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease;
    position:relative;overflow:hidden;
  }
  .codesano-page .cs-btn:hover{transform:translateY(-1px);}
  .codesano-page .cs-btn:active{transform:translateY(0) scale(.98);}
  .codesano-page .cs-btn-primary{background:var(--accent);color:#fff;box-shadow:0 6px 16px -6px rgba(53,89,224,.55);}
  .codesano-page .cs-btn-primary:hover{background:var(--accent-dark);}
  .codesano-page .cs-btn-primary::after{
    content:'';position:absolute;top:0;left:-60%;width:40%;height:100%;
    background:linear-gradient(120deg, transparent, rgba(255,255,255,.35), transparent);
    transform:skewX(-20deg);
  }
  .codesano-page .cs-btn-primary:hover::after{
    animation:cs-shine .8s ease;
  }
  @keyframes cs-shine{
    from{left:-60%;}
    to{left:130%;}
  }
  .codesano-page .cs-btn-sm{padding:9px 16px;font-size:13.5px;}

  /* Scroll reveal */
  .codesano-page .cs-reveal{
    opacity:0;
    transform:translateY(18px);
    transition:opacity .6s ease, transform .6s ease;
  }
  .codesano-page .cs-reveal.cs-visible{
    opacity:1;
    transform:translateY(0);
  }

  @media (prefers-reduced-motion: reduce){
    .codesano-page .cs-reveal{opacity:1;transform:none;transition:none;}
    .codesano-page .cs-btn-primary::after{display:none;}
  }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('cs-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('.cs-reveal').forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('.cs-reveal').forEach((el) => el.classList.add('cs-visible'));
  }
</script>