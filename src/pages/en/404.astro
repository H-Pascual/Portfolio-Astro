---
import BaseLayoutEn from "../../layouts/BaseLayoutEn.astro"
---
<BaseLayoutEn title={'Page not found - Héctor Pascual Marín'} noindex>
  <section class="not-found" aria-labelledby="nf-title">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h2 id="nf-title">This page doesn't exist</h2>
    <p>The link may be mistyped or the page may have moved. The home page will take you everywhere else.</p>
    <div class="action-row">
      <a href="/en/" class="primary-button button">Back to home</a>
      <a href="/en/projects" class="secondary-button button">See projects</a>
    </div>
  </section>
</BaseLayoutEn>
