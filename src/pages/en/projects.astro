---
import BaseLayoutEn from "../../layouts/BaseLayoutEn.astro";
import ProjectCard from '../../components/ProjectCard.astro';
import { ProjectListEn } from "../../data/ProjectListEn";
import Filter from "../../components/Filter.astro";
---
<BaseLayoutEn title="Projects - Héctor Pascual Marín | FullStack Developer" description="Projects by Héctor Pascual Marín, FullStack Developer in Alicante: corporate apps in C#/.NET and React, plus his own products such as Aulaventura.">
    <section class="all-projects" id="all-projects" aria-labelledby="all-projects-title">
        <header class="page-head">
            <h1 id="all-projects-title">Projects</h1>
            <p>Corporate applications I designed and led, products of my own running in production, and the projects where I learned the craft. Newest first.</p>
        </header>
        <Filter projects={ProjectListEn} lang="en" />
        <div class="projects-container">
            {ProjectListEn.map((project, i) => <ProjectCard project={project} lang="en" eager={i < 3} />)}
        </div>
    </section>
</BaseLayoutEn>
