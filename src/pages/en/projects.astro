---
import BaseLayoutEn from "../../layouts/BaseLayoutEn.astro";
import ProjectCard from '../../components/ProjectCard.astro';
import { ProjectListEn } from "../../data/ProjectListEn";
import Filter from "../../components/Filter.astro";
---
<BaseLayoutEn title="Projects - Héctor Pascual Marín | FullStack Developer" description="Projects by Héctor Pascual Marín, FullStack Developer in Alicante: Aulaventura, CodeSano, Renta Norte, Brokey and more, built with React, TypeScript, Astro, Angular and C#.">
    <section class="all-projects" id="all-projects" aria-labelledby="all-projects-title">
        <header class="page-head">
            <h2 id="all-projects-title">Projects</h2>
            <p>From products of my own running in production to the first projects where I learned the craft. Newest first.</p>
        </header>
        <Filter></Filter>
        <div class="projects-container">
            {ProjectListEn.map((project, i) => <ProjectCard project={project} lang="en" eager={i < 3} />)}
        </div>
    </section>
</BaseLayoutEn>
